<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Description>TeamCity HTTP API client library</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>TeamCity</PackageTags>
    <SkipNSwag Condition="'$(SkipNSwagger)' == ''">false</SkipNSwag>
    <NSwagExeOS Condition="'$(OS)' == 'Windows_NT'">$(NSwagExe)</NSwagExeOS>
    <NSwagExeOS Condition="'$(OS)' != 'Windows_NT'">$(NSwagExe_Net100)</NSwagExeOS>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NSwag.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Linq.Async" />
  </ItemGroup>

  <!-- Try to generate the code only once. Consider the .NET 10 as a default one-->
  <Target Name="NSwag" BeforeTargets="BeforeBuild;CoreCompile" Condition="'$(TargetFramework)' == 'net10.0' and '$(SkipNSwag)' != 'true'">
    <Error Condition="'$(NSwagExeOS)' == ''" Text="NSwag executable could not be determined for this platform. Ensure the NSwag.MSBuild package is properly restored." />
    <DownloadFile SourceUrl="http://localhost:8111/app/rest/swagger.json" DestinationFolder="$(MSBuildProjectDirectory)" DestinationFileName="swagger.json" />
    <Exec Command="$(NSwagExeOS) openapi2csclient /input:swagger.json /namespace:Dzaba.TeamCityClient /classname:TeamCityClient /jsonLibrary:SystemTextJson /generateClientInterfaces:true /operationGenerationMode:SingleClientFromOperationId /exposeJsonSerializerSettings:true /output:TeamCityClient.cs" />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Dzaba.TeamCityClient.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
